# Optional: override the default backend/pr_reviewer.db location.
SQLITE_DATABASE=pr_reviewer.db

# Production webhook URL from the active n8n PR Reviewer workflow.
N8N_PR_REVIEW_WEBHOOK_URL=https://n8n.nik-server.in/webhook/pr-review

# Webhook URL for the KT Chatbot n8n workflow.
N8N_KT_CHAT_WEBHOOK_URL=https://n8n.nik-server.in/webhook/kt-chatbot

# Secret key for encrypting stored GitHub access tokens / App passwords (Fernet key).
# Generate your own with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required. The app refuses to start without it. Never commit the real value.
ENCRYPTION_SECRET_KEY=

# Shared secret the n8n PR Reviewer workflow sends as the X-Internal-Token header
# when it calls GET /api/repositories/credentials to fetch a repo's GitHub username/PAT.
# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for that endpoint to work. Never commit the real value.
N8N_INTERNAL_TOKEN=

# Base URL for the portal backend used for n8n async callback requests.
# Exposed on host port 1806, accessible by n8n at host IP 192.168.1.104.
BACKEND_BASE_URL=http://192.168.1.104:1806
